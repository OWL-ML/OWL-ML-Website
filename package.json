{
  "name": "owl-ml-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website of the Open World Lifelong Machine Learning Lab (OWL-ML), Universität Bremen",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/validate-content.ts && npm run lint",
    "lint": "eslint . && prettier --check . && node scripts/lint-workflows.mjs",
    "format": "prettier --write .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "review": "node scripts/review.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y.mjs",
    "validate": "node scripts/validate-content.ts",
    "interactions": "node scripts/interactions.mjs",
    "links": "node scripts/links.mjs",
    "links:external": "node scripts/links.mjs --external",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run links && npm run a11y && npm run interactions",
    "demos:offline": "node scripts/demos-offline.mjs",
    "demos:traces": "python3 tools/demos/pytrace.py src/demos/step-through-python/traces.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@retorquere/bibtex-parser": "^12.1.3",
    "astro": "^7.3.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5",
    "actionlint": "^2.0.6",
    "axe-core": "^4.14.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "qrcode": "^1.5.4",
    "satori": "^0.56.1",
    "sharp": "^0.35.5",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22"
  }
}
