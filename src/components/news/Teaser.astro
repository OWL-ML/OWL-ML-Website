---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Teaser figure of a paper for news tiles. Until real thumbnails exist (src/assets/papers/),
// a calm bar pattern seeded from the title is drawn instead, so it never changes between builds.
interface Props {
  image?: ImageMetadata;
  seed: string;
  shape?: 'wide' | 'square';
}
const { image, seed, shape = 'wide' } = Astro.props;
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619) >>> 0;
const rand = () => ((h = Math.imul(h ^ (h >>> 15), 2246822507) >>> 0), (h % 1000) / 1000);
const bars = Array.from({ length: 5 }, () => 0.35 + rand() * 0.55);
const hot = Math.floor(rand() * 5);
---

<div class:list={['teaser', shape]} aria-hidden="true">
  {image ? (
    shape === 'wide' ? (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        widths={[360, 720, 1080]}
        sizes="(max-width: 720px) 100vw, 720px"
        layout="none"
        class="img"
      />
    ) : (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        width={240}
        widths={[120, 240]}
        sizes="120px"
        class="img"
      />
    )
  ) : shape === 'wide' ? (
    <svg viewBox="0 0 600 180" preserveAspectRatio="none">
      {bars.map((b, i) => (
        <rect
          x={30 + i * 110}
          y={180 - b * 160}
          width="96"
          height={b * 160}
          fill={i === hot ? '#E38A43' : i % 2 ? '#4E9A8F' : '#8ACBB7'}
        />
      ))}
    </svg>
  ) : (
    <svg viewBox="0 0 120 120">
      <rect
        x="18"
        y="24"
        width="30"
        height="72"
        rx="5"
        fill="none"
        stroke="#00756A"
        stroke-width="3"
      />
      <rect
        x="54"
        y="24"
        width="22"
        height="34"
        rx="5"
        fill="none"
        stroke="#00756A"
        stroke-width="3"
      />
      <rect
        x="82"
        y="44"
        width="20"
        height="34"
        rx="5"
        fill="none"
        stroke="#00756A"
        stroke-width="3"
      />
      <rect
        x="54"
        y="64"
        width="22"
        height="32"
        rx="5"
        fill="none"
        stroke="#E38A43"
        stroke-width="3"
      />
    </svg>
  )}
</div>

<style>
  .teaser {
    background: var(--teal-700);
    overflow: hidden;
  }
  .wide {
    height: 180px;
  }
  .wide svg {
    width: 100%;
    height: 100%;
  }
  .square {
    background: var(--teal-50);
    border-radius: 14px;
    width: 120px;
    height: 120px;
    flex: none;
  }
  .img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--white);
  }
</style>
