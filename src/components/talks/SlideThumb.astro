---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// First-page thumbnail of slides or a poster. Without a thumbnail file a neutral drawing is shown
// (variant picked from the title so it stays the same between builds).
interface Props {
  image?: ImageMetadata;
  title: string;
  kind: 'slides' | 'poster';
}
const { image, title, kind } = Astro.props;
let h = 0;
for (const ch of title) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const variant = kind === 'poster' ? 'poster' : (['dark', 'cards', 'chart'] as const)[h % 3];
---

<div class:list={['thumb', `v-${variant}`]}>
  {image ? (
    <Picture
      src={image}
      alt=""
      formats={['avif', 'webp']}
      width={640}
      height={360}
      widths={[320, 640]}
      sizes="(max-width: 720px) 100vw, 400px"
      fit="cover"
      layout="none"
      class="img"
    />
  ) : (
    <svg viewBox="0 0 320 180" aria-hidden="true" class="drawing">
      {variant === 'dark' && (
        <>
          <rect x="26" y="62" width="200" height="8" rx="4" fill="#fff" />
          <rect x="26" y="84" width="145" height="8" rx="4" fill="#fff" />
          <rect x="26" y="112" width="100" height="5" rx="2.5" fill="#6E8783" />
          <rect x="26" y="154" width="46" height="5" rx="2.5" fill="#E38A43" />
        </>
      )}
      {variant === 'cards' && (
        <>
          <rect x="24" y="22" width="156" height="8" rx="4" fill="#1F4A47" />
          {[24, 124, 224].map((x) => (
            <>
              <rect x={x} y="48" width="84" height="82" rx="8" fill="#D3EAE4" />
              <circle cx={x + 18} cy="66" r="9" fill="#1F4A47" />
              <rect x={x + 8} y="88" width="66" height="4" rx="2" fill="#6E8783" />
              <rect x={x + 8} y="100" width="46" height="4" rx="2" fill="#6E8783" />
            </>
          ))}
          <rect x="24" y="144" width="130" height="14" rx="7" fill="#E38A43" />
        </>
      )}
      {variant === 'chart' && (
        <>
          <rect x="24" y="22" width="136" height="8" rx="4" fill="#1F4A47" />
          <path d="M24 46 V158 H200" stroke="#BFDDD5" stroke-width="2" fill="none" />
          <rect x="42" y="116" width="28" height="42" fill="#6E8783" />
          <rect x="78" y="90" width="28" height="68" fill="#6E8783" />
          <rect x="114" y="104" width="28" height="54" fill="#6E8783" />
          <rect x="150" y="62" width="28" height="96" fill="#E38A43" />
          {[60, 74, 88, 102].map((y, i) => (
            <rect
              x="214"
              y={y}
              width={i === 3 ? 56 : 92 - i * 8}
              height="4"
              rx="2"
              fill="#6E8783"
            />
          ))}
        </>
      )}
      {variant === 'poster' && (
        <>
          <rect x="110" y="10" width="112" height="160" fill="#fff" />
          <rect x="126" y="24" width="80" height="14" fill="#1F4A47" />
          <rect x="126" y="46" width="38" height="50" fill="#D3EAE4" />
          <rect x="168" y="46" width="38" height="50" fill="#D3EAE4" />
          <rect x="126" y="102" width="38" height="50" fill="#E38A43" />
          <rect x="168" y="102" width="38" height="50" fill="#D3EAE4" />
        </>
      )}
    </svg>
  )}
  <span class="kind">{kind === 'poster' ? 'Poster' : 'Slides'} · PDF</span>
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--teal-300);
    background: var(--white);
  }
  .v-dark {
    background: var(--teal-700);
    border-color: var(--teal-700);
  }
  .v-poster {
    background: var(--teal-200);
    border-color: var(--teal-200);
  }
  .img,
  .drawing {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kind {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 2px 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }
</style>
