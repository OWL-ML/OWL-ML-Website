---
import { site, githubUrl } from '../lib/site';
---

<footer class="site-footer">
  <div class="container inner">
    <div class="lab">
      <span class="name">
        <img src="/brand/owl.svg" alt="" width="230" height="320" class="owl" />
        <span>
          Open World Lifelong
          <br />
          Machine Learning Lab
        </span>
      </span>
      <span>{site.university} · Faculty 3</span>
      <span>{site.address}</span>
    </div>
    <ul class="links">
      <li>
        <a href="/legal/">Legal notice & privacy</a>
      </li>
      <li>
        <a href="/accessibility/">Accessibility</a>
      </li>
      {githubUrl ? (
        <li>
          <a href={githubUrl}>GitHub</a>
        </li>
      ) : (
        <li class="placeholder-link">GitHub [link]</li>
      )}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--teal-700);
    color: var(--on-dark-subtle);
    font-size: 15px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px 48px;
    padding-block: 48px;
  }
  .lab {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--white);
  }
  .owl {
    height: 52px;
    width: auto;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--on-dark);
  }
  .links a:hover {
    color: var(--white);
  }
  .links a:focus-visible {
    outline-color: var(--peach-light);
  }
</style>
