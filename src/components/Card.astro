---
// White surface: no border, no shadow (docs/DESIGN.md).
interface Props {
  as?: 'div' | 'article' | 'section' | 'aside' | 'li';
  size?: 'md' | 'sm';
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = 'div', size = 'md', class: cls, ...rest } = Astro.props;
---

<Tag class:list={['card', `card-${size}`, cls]} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-sm {
    border-radius: var(--radius-card-sm);
    padding: 24px 28px;
    gap: 8px;
  }
  @media (max-width: 720px) {
    .card {
      padding: 24px;
    }
    .card-sm {
      padding: 20px;
    }
  }
</style>
