---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import owl from '../assets/brand/owl-square.png';

// A member photo, or the lab's owl (as supplied, on a light background) while there is none.
// Never a stock image. The empty placeholder card shows a dash.
interface Props {
  name: string;
  photo?: ImageMetadata;
  /** pixel size of the square/circle; 'fill' takes the container width (team grid) */
  size?: number | 'fill';
  shape?: 'square' | 'circle';
  tone?: 'light' | 'dark' | 'peach';
  /** Empty placeholder card: shows a dash instead of the owl */
  placeholder?: boolean;
  class?: string;
  /** page transition name (base.css), e.g. "person-mundt": must be unique on the page */
  transitionName?: string;
}
const {
  photo,
  size = 40,
  shape = 'circle',
  tone = 'light',
  placeholder = false,
  class: cls,
  transitionName,
} = Astro.props;

const px = size === 'fill' ? undefined : size;
const image = photo ?? (placeholder ? undefined : owl);
const style =
  [
    px && `width:${px}px;height:${px}px;font-size:${Math.round(px * 0.38)}px`,
    transitionName && `view-transition-name:${transitionName}`,
  ]
    .filter(Boolean)
    .join(';') || undefined;
---

<span
  class:list={[
    'avatar',
    shape,
    image === owl ? 'owl' : `tone-${tone}`,
    size === 'fill' && 'fill',
    cls,
  ]}
  style={style}
>
  {image ? (
    px ? (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        width={px}
        height={px}
        widths={[px, px * 2]}
        sizes={`${px}px`}
        fit="cover"
        class="img"
      />
    ) : (
      <Picture
        src={image}
        alt=""
        formats={['avif', 'webp']}
        width={480}
        height={480}
        widths={[240, 480]}
        sizes="(max-width: 720px) 45vw, 240px"
        fit="cover"
        layout="none"
        class="img"
      />
    )
  ) : (
    <span aria-hidden="true">—</span>
  )}
</span>

<style>
  .avatar {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1;
  }
  .circle {
    border-radius: 50%;
  }
  .square {
    border-radius: 14px;
  }
  .fill {
    width: 100%;
    aspect-ratio: 1;
    font-size: 34px;
  }
  .tone-light {
    background: var(--teal-200);
    color: var(--body);
  }
  .tone-dark {
    background: var(--teal-line-dark);
    color: var(--on-dark-subtle);
  }
  .tone-peach {
    background: var(--peach-200);
    color: var(--on-peach);
  }
  .img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* the owl's strokes reach beyond its orange body: always on a light background */
  .owl {
    background: var(--teal-100);
  }
  .owl .img {
    object-fit: contain;
  }
</style>
