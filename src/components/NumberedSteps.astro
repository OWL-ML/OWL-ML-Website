---
// "How to reach out": dark circular numerals; the final step is orange.
interface Step {
  title: string;
  text: string;
  link?: { label: string; href: string };
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {steps.map((s, i) => (
    <li class:list={['step', i === steps.length - 1 && 'last']}>
      <span class="num" aria-hidden="true">
        {i + 1}
      </span>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
      {s.link && (
        <a class="more-link" href={s.link.href}>
          {s.link.label}
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--teal-700);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
  }
  .last .num {
    background: var(--orange);
    color: var(--on-orange);
  }
  h3 {
    font-size: 24px;
  }
  p {
    color: var(--body);
    flex: 1;
  }
</style>
