---
import { site } from '../../lib/site';

const roman = ['I', 'II', 'III', 'IV', 'V'];
---

<section class="container section pillars" aria-labelledby="pillars-h">
  <div class="section-intro">
    <h2 id="pillars-h">Why open world lifelong machine learning?</h2>
  </div>
  <div class="grid">
    {site.pillars.map((p, i) => (
      <article class="card">
        <div class="kicker">
          <span class="num">{roman[i] ?? i + 1}</span>
          <span class="label-mono">{p.label}</span>
        </div>
        <h3>{p.heading}</h3>
        <p>{p.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .pillars {
    padding-top: 88px;
    gap: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .num {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--teal-200);
    color: var(--teal-800);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 15px;
  }
  .label-mono {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--muted);
  }
  h3 {
    font-size: 28px;
    line-height: 1.15;
  }
  .card p {
    color: var(--body);
  }
  @media (max-width: 720px) {
    .pillars {
      padding-top: 48px;
    }
    .card {
      padding: 24px;
    }
    h3 {
      font-size: 24px;
    }
  }
</style>
