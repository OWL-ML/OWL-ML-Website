---
import AwardBadge from '../AwardBadge.astro';
import Authors from '../Authors.astro';
import { getPublications } from '../../lib/data';
import { landingPage } from '../../lib/paper-page';

// Featured papers. Awarded or spotlight papers first (newest first), at most two on desktop and
// one on phones, as in the mockups.
const featured = (await getPublications()).filter((p) => p.featured);
const picks = [...featured.filter((p) => p.award), ...featured.filter((p) => !p.award)].slice(0, 2);
---

<div class="col">
  <h2 id="highlights-h">Highlights</h2>
  {picks.map((p, i) => (
    <article class:list={['card', i > 0 && 'desktop-only']}>
      {p.award && (
        <AwardBadge kind={/spotlight|oral/i.test(p.award) ? 'spotlight' : 'award'} size="md">
          {p.award}
          {p.note_type === 'position' ? ' position paper' : ''} · {p.venue_short}
        </AwardBadge>
      )}
      <h3>{p.title}</h3>
      <Authors pub={p} />
      <div class="links">
        <a href={landingPage(p) ?? `/publications/#${p.key}`}>
          Paper<span class="sr-only">: {p.title}</span>
        </a>
        <a href={`/publications/#${p.key}`}>
          BibTeX<span class="sr-only"> of {p.title}</span>
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }
  .card {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  h3 {
    font-size: 27px;
    line-height: 1.2;
  }
  .links {
    display: flex;
    gap: 20px;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .desktop-only {
      display: none;
    }
    .card {
      padding: 24px;
    }
    h3 {
      font-size: 24px;
    }
  }
</style>
