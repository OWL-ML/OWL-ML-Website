---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ThemeTag from '../../components/ThemeTag.astro';
import JoinBand from '../../components/JoinBand.astro';
import { getCourses, getTalks } from '../../lib/data';
import { site } from '../../lib/site';
import { isPlaceholder } from '../../lib/format';
import { stageLabels, semesterLabels, languageLabels } from '../../lib/courses';
import { stages } from '../../lib/content/schemas';
import DemoFrame from '../../components/demos/DemoFrame.astro';
import SeminarDimensions from '../../components/teaching/SeminarDimensions.astro';
import { demos, demoBySlug } from '../../demos/registry';
import { getThemes } from '../../lib/themes';

// The page starts with the course path; each course's semester comes from courses.yml, so nothing
// here changes from term to term. Phase 3: everything is static and complete without JavaScript. Phase 5 turns the course path
// into a selector (one course panel at a time, winter/summer filter); phase 5b adds "Try it" with
// the course demos (src/demos/registry.ts) between the path and the material links. Courses have
// no pages of their own: the panel shows the short description, materials (slides, notebooks) and
// where the course can lead; /teaching/#course-<id> selects the panel.
const courses = await getCourses();
const byId = new Map(courses.map((c) => [c.id, c]));
const columns = stages.map((s) => ({ stage: s, courses: courses.filter((c) => c.stage === s) }));
const ext = (url?: string) => (url && !isPlaceholder(url) ? url : undefined);
// Only material that is online is shown: course materials without a real link, the Zenodo slides
// (until `zenodo_url` is set in site.yml) and the recordings (until a talk has a video) stay
// hidden, as decided by Martin before launch (November 2026).
const materialsOf = (c: (typeof courses)[number]) => c.materials.filter((m) => ext(m.url));
const zenodoUrl = ext(site.zenodo_url);
const hasRecordings = (await getTalks()).some((t) => t.data.video);
// `pairs` is listed on one side in courses.yml and holds both ways; a suggested next course is
// shown as that
const pairsOf = (id: string) => {
  const c = byId.get(id)!;
  return courses.filter(
    (x) =>
      x.id !== id && !c.next.includes(x.id) && (x.pairs.includes(id) || c.pairs.includes(x.id)),
  );
};
const semLang = (c: (typeof courses)[number]) =>
  [c.degree, semesterLabels[c.semester], c.language && languageLabels[c.language]]
    .filter(Boolean)
    .join(' – ');

// "Try it": one slot per course, the course's demo or its centrepiece (docs/DEMOS.md). Only the
// selected slot is visible, and a demo loads nothing until it is visible. Without JavaScript the
// first course's slot is shown and the chips lead to the demo pages.
const themes = await getThemes();
const tryCourses = courses.filter((c) => c.demo.length > 0 || c.centrepiece);
const defaultTry = 'traki';
const demoChips = demos.map((d) => ({ ...d, courseId: d.course }));
const showcaseText =
  'Projects get a showcase instead: what students built in earlier runs, shared with their consent. [To be added.]';
---

<BaseLayout
  title="Teaching"
  current="teaching"
  description="Courses of the OWL-ML lab, from a first AI course to a thesis."
>
  <PageHero
    slot="band"
    title="Teaching"
    lead="A curriculum for humans, from people who study how machines learn over time. Course enrollment is through Stud.IP."
  />

  <section class="container section" aria-labelledby="path-h">
    <div class="section-intro">
      <h2 id="path-h">A path through our courses</h2>
      <p>
        We teach the way we think machines should learn. Pick a course to see what it covers and
        where it can lead. These are suggestions, not formal prerequisites.
      </p>
    </div>
    <div class="path-card" data-path>
      <div class="sem-filter js-only" role="group" aria-labelledby="sem-label">
        <span class="label" id="sem-label">
          Offered in
        </span>
        <button type="button" class="schip" data-sem="" aria-pressed="true">
          Both semesters
        </button>
        <button type="button" class="schip" data-sem="winter" aria-pressed="false">
          Winter
        </button>
        <button type="button" class="schip" data-sem="summer" aria-pressed="false">
          Summer
        </button>
      </div>
      <div class="path">
        {columns.map(({ stage, courses }, i) => (
          <section class="stage" aria-labelledby={`stage-${stage}`}>
            <h3 id={`stage-${stage}`} class="stage-h">
              <span class="stage-num">{String(i + 1).padStart(2, '0')}</span>
              {stageLabels[stage]}
            </h3>
            <ul>
              {courses.map((c) => (
                <li>
                  <a
                    class="course"
                    href={`#course-${c.id}`}
                    data-course={c.id}
                    data-semester={c.semester}
                  >
                    <span class="course-name" lang={c.name_en ? c.language : undefined}>
                      {c.name}
                    </span>
                    {c.name_en && <span class="course-en">{c.name_en}</span>}
                    <span class="course-sem">{semLang(c)}</span>
                    <span class="next-tag" hidden />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="details" aria-live="polite">
        {courses.map((c) => (
          <article
            class="detail"
            id={`course-${c.id}`}
            data-next={c.next.join(' ')}
            data-pairs={pairsOf(c.id)
              .map((x) => x.id)
              .join(' ')}
          >
            <div class="detail-main">
              <p class="detail-meta">
                {[
                  c.kind,
                  c.level,
                  semesterLabels[c.semester],
                  c.language && `Taught in ${languageLabels[c.language]}`,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </p>
              <h3 lang={c.name_en ? c.language : undefined}>{c.name}</h3>
              {c.name_en && <p class="name-en">{c.name_en}</p>}
              <p class="desc">{c.description}</p>
              {c.centrepiece === 'theses' && (
                <a class="more-link" href="/theses/">
                  Thesis themes and how to reach out →
                </a>
              )}
              {c.themes.length > 0 && (
                <div class="tags">
                  {c.themes.map((t) => (
                    <ThemeTag id={t} />
                  ))}
                </div>
              )}
            </div>
            {(materialsOf(c).length > 0 ||
              c.next.length > 0 ||
              pairsOf(c.id).length > 0 ||
              ext(c.studip)) && (
              <div class="detail-side">
                {materialsOf(c).length > 0 && (
                  <>
                    <p class="label">Materials</p>
                    <ul>
                      {materialsOf(c).map((m) => (
                        <li>
                          <a href={m.url}>{m.title} ↗</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {pairsOf(c.id).length > 0 && (
                  <>
                    <p class="label">Goes with</p>
                    <ul>
                      {pairsOf(c.id).map((x) => (
                        <li>
                          <a href={`#course-${x.id}`}>{x.name} →</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {c.next.length > 0 && <p class="label">Where it can lead</p>}
                <ul>
                  {c.next.map((n) => (
                    <li>
                      <a href={`#course-${n}`}>{byId.get(n)?.name} →</a>
                    </li>
                  ))}
                  {ext(c.studip) && (
                    <li>
                      <a href={ext(c.studip)}>Course page on Stud.IP ↗</a>
                    </li>
                  )}
                </ul>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container section" id="try" aria-labelledby="try-h" data-try>
    <div class="try-head">
      <div class="section-intro">
        <h2 id="try-h">Try a small hands-on piece of each course</h2>
        <p>The demo follows the course you pick in the path above, or jump straight to one.</p>
      </div>
      <nav class="try-chips" aria-label="Course demos">
        {demoChips.map((d) => (
          <a
            class="schip"
            href={`/teaching/demos/${d.slug}/`}
            data-try-course={d.courseId}
            aria-current={d.courseId === defaultTry ? 'true' : undefined}
          >
            {d.short}
          </a>
        ))}
      </nav>
    </div>
    {tryCourses.map((c) => (
      <div class="try-slot" data-try-slot={c.id} hidden={c.id !== defaultTry}>
        {c.demo[0] && demoBySlug.has(c.demo[0]) ? (
          <>
            <DemoFrame slug={c.demo[0]} courseName={c.name} headingLevel={3} />
            {c.dimensions.length > 0 && (
              <div class="slot-dims">
                <SeminarDimensions dimensions={c.dimensions} demo />
              </div>
            )}
          </>
        ) : c.centrepiece === 'theses' ? (
          <div class="centrepiece">
            <h3>{c.name}</h3>
            <p>
              Guided research and theses grow out of our research themes; see the thesis page for
              how to get started.
            </p>
            <ul class="cp-themes">
              {themes.map((t) => (
                <li>
                  <span class="cp-oneliner">{t.oneliner}</span>
                  <span class="cp-name">{t.name}</span>
                </li>
              ))}
            </ul>
            <a class="more-link" href="/theses/#reach-out">
              How to reach out →
            </a>
          </div>
        ) : c.centrepiece === 'dimensions' ? (
          <div class="centrepiece">
            <h3>{c.name}</h3>
            <SeminarDimensions dimensions={c.dimensions} />
          </div>
        ) : (
          <div class="centrepiece">
            <h3>{c.name}</h3>
            <p>{showcaseText}</p>
          </div>
        )}
      </div>
    ))}
  </section>

  {(zenodoUrl || hasRecordings) && (
    <section class="container section" aria-label="Open material">
      <ul class="material">
        {zenodoUrl && (
          <li class="mat">
            <h3>Lecture slides</h3>
            <p>Public slide decks with permanent links on Zenodo.</p>
            <a class="more-link" href={zenodoUrl}>
              Browse the slides →
            </a>
          </li>
        )}
        {hasRecordings && (
          <li class="mat">
            <h3>Recordings</h3>
            <p>Selected lectures, loaded only after you choose to play them.</p>
            <a class="more-link" href="/publications/talks/">
              Watch →
            </a>
          </li>
        )}
      </ul>
    </section>
  )}

  <div class="container join-wrap">
    <JoinBand
      title="Ready for research?"
      text="Guided research projects and theses grow out of our research themes, shaped together with you."
      cta="Get in touch about a thesis"
      href="/theses/"
    />
  </div>
</BaseLayout>

<script>
  import { revealPanel } from '../../lib/motion';

  // Course path: pick a course to see its panel and the suggested next courses; filter by
  // semester. Without JavaScript every course has its own panel below the path.
  const root = document.querySelector<HTMLElement>('[data-path]');
  if (root) {
    root.classList.add('enhanced');
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('[data-course]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.detail')];
    const semChips = [...root.querySelectorAll<HTMLButtonElement>('[data-sem]')];
    let current = 'traki';
    const trySlots = [...document.querySelectorAll<HTMLElement>('[data-try-slot]')];
    const tryChips = [...document.querySelectorAll<HTMLAnchorElement>('[data-try-course]')];
    let sem = '';
    const offered = (s: string) => !sem || s === sem || s === 'both' || s === 'any';
    let rendered = false; // the first rendering (page load) is not animated
    const render = () => {
      const panel = panels.find((p) => p.id === `course-${current}`);
      const list = (k: 'next' | 'pairs') =>
        new Set((panel?.dataset[k] ?? '').split(' ').filter(Boolean));
      const next = list('next');
      const pairs = list('pairs');
      for (const c of cards) {
        const id = c.dataset.course!;
        const tag = c.querySelector<HTMLElement>('.next-tag')!;
        c.setAttribute('aria-pressed', String(id === current));
        c.classList.toggle('is-next', next.has(id) || pairs.has(id));
        tag.textContent = pairs.has(id) ? 'Goes with this' : 'Suggested next';
        tag.hidden = !next.has(id) && !pairs.has(id);
        c.classList.toggle('not-offered', !offered(c.dataset.semester!));
      }
      const before = panels.find((p) => !p.hidden);
      for (const p of panels) p.hidden = p !== panel;
      if (rendered && panel !== before) revealPanel(panel); // a different course fades in
      // "Try it" follows the selected course; courses without demo or centrepiece keep the last
      if (trySlots.some((s) => s.dataset.trySlot === current)) {
        const slotBefore = trySlots.find((s) => !s.hidden);
        for (const s of trySlots) s.hidden = s.dataset.trySlot !== current;
        const slot = trySlots.find((s) => !s.hidden);
        if (rendered && slot !== slotBefore) revealPanel(slot);
        for (const c of tryChips)
          if (c.dataset.tryCourse === current) c.setAttribute('aria-current', 'true');
          else c.removeAttribute('aria-current');
      }
      for (const b of semChips) b.setAttribute('aria-pressed', String(b.dataset.sem === sem));
      rendered = true;
    };
    const select = (id: string) => {
      if (!cards.some((c) => c.dataset.course === id)) return;
      current = id;
      render();
    };
    cards.forEach((c) => {
      c.setAttribute('role', 'button');
      c.addEventListener('click', (e) => {
        e.preventDefault();
        select(c.dataset.course!);
        history.replaceState(null, '', `#course-${c.dataset.course}`);
      });
      c.addEventListener('keydown', (e) => {
        if (e.key === ' ') {
          e.preventDefault();
          c.click();
        }
      });
    });
    tryChips.forEach((c) =>
      c.addEventListener('click', (e) => {
        e.preventDefault();
        select(c.dataset.tryCourse!);
      }),
    );
    semChips.forEach((b) =>
      b.addEventListener('click', () => {
        sem = b.dataset.sem ?? '';
        render();
      }),
    );
    // links elsewhere on the page and from profiles: #course-<id>
    const fromHash = () => {
      const m = location.hash.match(/^#course-(.+)$/);
      if (m) {
        select(m[1]!);
        root.scrollIntoView({ block: 'start' });
      }
    };
    window.addEventListener('hashchange', fromHash);
    render();
    fromHash();
  }
</script>

<style>
  .path-card {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .sem-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .schip {
    font-size: 14px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--white);
    border: 1px solid var(--teal-300);
    cursor: pointer;
  }
  .schip[aria-pressed='true'] {
    background: var(--teal-700);
    border-color: var(--teal-700);
    color: var(--white);
  }
  .path {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .stage {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .stage-h {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 21px;
  }
  .stage-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--teal-700);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .stage ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .course {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid var(--teal-300);
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
  }
  .course:hover {
    border-color: var(--teal-500);
  }
  .course[aria-pressed='true'] {
    background: var(--teal-700);
    border-color: var(--teal-700);
    color: var(--white);
  }
  .course[aria-pressed='true'] .course-sem {
    color: var(--on-dark-muted);
  }
  .course.is-next {
    border: 2px solid var(--orange);
    padding: 11px 13px;
  }
  .course.not-offered {
    opacity: 0.45;
  }
  .next-tag {
    align-self: flex-start;
    margin-top: 4px;
    font-size: 11px;
    font-weight: 600;
    background: var(--peach-200);
    color: var(--on-peach);
    padding: 1px 8px;
    border-radius: var(--radius-pill);
  }
  .next-tag[hidden] {
    display: none;
  }
  .enhanced .details {
    grid-template-columns: minmax(0, 1fr);
  }
  .enhanced .detail {
    background: var(--teal-50);
    outline: none;
  }
  .course-name {
    font-weight: 600;
    font-size: 15px;
  }
  .course-en {
    font-size: 13px;
    color: var(--body);
  }
  .course[aria-pressed='true'] .course-en {
    color: var(--on-dark-muted);
  }
  .name-en {
    margin-top: -4px;
    font-weight: 600;
    color: var(--body);
  }
  .course-sem {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .details {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr));
    gap: 16px;
  }
  .detail {
    background: var(--teal-50);
    border: 1px solid var(--hairline);
    border-radius: 18px;
    padding: 22px 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 28px;
    scroll-margin-top: 16px;
  }
  .detail:target {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
    background: var(--white);
  }
  .detail-main {
    flex: 2 1 280px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .detail-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--teal-600);
  }
  .detail h3 {
    font-size: 24px;
  }
  .desc {
    color: var(--body);
    font-size: 15px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .detail-side {
    flex: 1 1 180px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .detail-side ul + .label {
    margin-top: 10px;
  }
  .detail-side ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
  }
  .material {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mat {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mat h3 {
    font-size: 22px;
  }
  .mat p {
    color: var(--body);
    font-size: 15px;
  }
  .try-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    margin-bottom: 20px;
  }
  .try-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .try-chips a {
    color: var(--ink);
    text-decoration: none;
  }
  .try-chips a[aria-current='true'] {
    background: var(--teal-700);
    border-color: var(--teal-700);
    color: var(--white);
  }
  .centrepiece {
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .centrepiece h3 {
    font-size: 24px;
  }
  .centrepiece p {
    color: var(--body);
    max-width: 680px;
  }
  .cp-themes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 12px;
  }
  .cp-themes li {
    background: var(--teal-50);
    border-radius: var(--radius-card-sm);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cp-oneliner {
    font-size: 13px;
    color: var(--body);
  }
  .cp-name {
    font-weight: 600;
  }
  .slot-dims {
    margin-top: 12px;
    background: var(--white);
    border-radius: var(--radius-card);
    padding: 24px 32px;
  }
  .join-wrap {
    padding-block: 16px 88px;
  }
  @media (max-width: 1000px) {
    .path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 720px) {
    .path {
      grid-template-columns: minmax(0, 1fr);
    }
    .path-card {
      padding: 20px;
    }
    .join-wrap {
      padding-block: 8px 48px;
    }
    .slot-dims {
      padding: 20px;
    }
  }
</style>
