    {contactEmail ? (
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
    ) : (
      <span class="ph">[lab email]</span>
    )}
  </p>

  <h3>Data protection officer</h3>
  <p>
    University of Bremen, Katja Losch-Kremer, Referat 06
    <br />
    Bibliothekstraße 1–3, 28359 Bremen, Germany
    <br />
    Email: <a href="mailto:datenschutz@uni-bremen.de">datenschutz@uni-bremen.de</a>
    <br />
    Website:{' '}
    <a href="https://www.uni-bremen.de/infoportal-datenschutz">
      www.uni-bremen.de/infoportal-datenschutz
    </a>
