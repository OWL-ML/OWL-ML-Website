---
// Legal notice and privacy statement in one page, after the University of Bremen's own pages
// (https://www.uni-bremen.de/en/legal-notice, /en/data-privacy, and its disclaimer). Their general
// parts are taken word for word (obvious typos fixed); the sections on this website's own data
// processing (hosting, cookies, fonts, videos, email) describe this site, with the legal bases the
// university and other lab sites (AGRA) use for the same kind of processing, and the university's
// date ("as of July 2018"), as decided by Martin (November 2026). English only; the university's
// German statements are linked as the binding versions.
import LegalPage from '../layouts/LegalPage.astro';
import { site, contactEmail } from '../lib/site';

const responsible = 'Prof. Dr. Martin Mundt';
---

<LegalPage
  title="Legal notice & privacy"
  lead="Who provides this website, and how it handles personal data"
  lang="en"
>
  <p>
    This page follows the University of Bremen's legal notice and privacy statement. The German
    versions of the university's statements are legally binding:{' '}
    <a href="https://www.uni-bremen.de/impressum" lang="de">
      Impressum
    </a>{' '}
    and{' '}
    <a href="https://www.uni-bremen.de/datenschutz" lang="de">
      Datenschutz
    </a>
    .
  </p>

  <h2 id="legal-notice">Legal notice</h2>

  <h3>Provider</h3>
  <p>
    {site.university}
    <br />
    {site.faculty}
    <br />
    {site.name} ({site.short})<br />
    {site.address}
    {contactEmail && (
      <>
        <br />
        Email: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </>
    )}
  </p>

  <h3>Responsible for content</h3>
